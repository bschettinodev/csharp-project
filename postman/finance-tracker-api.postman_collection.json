{
  "info": {
    "name": "Finance Tracker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5057" },
    { "key": "accountId", "value": "" },
    { "key": "account2Id", "value": "" },
    {
      "key": "expenseCategoryId",
      "value": "22222222-2222-4222-8222-222222222221"
    },
    {
      "key": "incomeCategoryId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    { "key": "transactionId", "value": "" },
    { "key": "incomeTransactionId", "value": "" }
  ],
  "item": [
    {
      "name": "== CATEGORIES ==",
      "item": [
        {
          "name": "01 - Get All Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has categories', () => pm.expect(res.length).to.be.above(0));",
                  "pm.test('Has income categories', () => {",
                  "  const income = res.filter(c => c.type === 'Income');",
                  "  pm.expect(income.length).to.be.above(0);",
                  "});",
                  "pm.test('Has expense categories', () => {",
                  "  const expense = res.filter(c => c.type === 'Expense');",
                  "  pm.expect(expense.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Get Category By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories/{{expenseCategoryId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Is expense type', () => pm.expect(res.type).to.eql('Expense'));",
                  "pm.test('Has color', () => pm.expect(res.color).to.match(/^#[A-Fa-f0-9]{6}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Get Category Not Found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "== ACCOUNTS ==",
      "item": [
        {
          "name": "04 - Create Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nubank\",\n  \"type\": 1,\n  \"initialBalance\": 1000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('accountId', res.id);",
                  "pm.test('Has id', () => pm.expect(res.id).to.be.a('string'));",
                  "pm.test('CurrentBalance equals InitialBalance', () => pm.expect(res.currentBalance).to.eql(1000));",
                  "pm.test('Type is string', () => pm.expect(res.type).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - Create Second Account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Inter\",\n  \"type\": 1,\n  \"initialBalance\": 500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('account2Id', res.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - Create Account Duplicate Name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nubank\",\n  \"type\": 1,\n  \"initialBalance\": 500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "const res = pm.response.json();",
                  "pm.test('Has error message', () => pm.expect(res.message).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - Create Account Duplicate Name Case Insensitive",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"NUBANK\",\n  \"type\": 1,\n  \"initialBalance\": 500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - Create Account Negative Balance",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/accounts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carteira\",\n  \"type\": 1,\n  \"initialBalance\": -100\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - Get All Accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has 2 accounts', () => pm.expect(res.length).to.eql(2));",
                  "pm.test('Ordered by name', () => {",
                  "  pm.expect(res[0].name).to.eql('Inter');",
                  "  pm.expect(res[1].name).to.eql('Nubank');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10 - Get Account By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Correct account', () => pm.expect(res.name).to.eql('Nubank'));",
                  "pm.test('Has currentBalance', () => pm.expect(res.currentBalance).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - Get Account Not Found",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 - Update Account",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/accounts/{{accountId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nubank Updated\",\n  \"type\": 1,\n  \"initialBalance\": 1000\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 - Update Account Not Found",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/accounts/00000000-0000-0000-0000-000000000000",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ghost\",\n  \"type\": 1,\n  \"initialBalance\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "== TRANSACTIONS ==",
      "item": [
        {
          "name": "14 - Create Income Transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Salário maio\",\n  \"amount\": 3000,\n  \"date\": \"2026-05-01T08:00:00Z\",\n  \"type\": 1,\n  \"accountId\": \"{{accountId}}\",\n  \"categoryId\": \"{{incomeCategoryId}}\",\n  \"notes\": \"Salário mensal\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('incomeTransactionId', res.id);",
                  "pm.test('Has accountName', () => pm.expect(res.accountName).to.be.a('string'));",
                  "pm.test('Has categoryName', () => pm.expect(res.categoryName).to.be.a('string'));",
                  "pm.test('Type is string', () => pm.expect(res.type).to.eql('Income'));"
                ]
              }
            }
          ]
        },
        {
          "name": "15 - Create Expense Transaction",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/transactions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Almoço\",\n  \"amount\": 35,\n  \"date\": \"2026-05-05T12:00:00Z\",\n  \"type\": 2,\n  \"accountId\": \"{{accountId}}\",\n  \"categoryId\": \"{{expenseCategoryId}}\",\n  \"notes\": \"Comida\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('transactionId', res.id);",
                  "pm.test('Type is Expense', () => pm.expect(res.type).to.eql('Expense'));"
                ]
              }
            }
          ]
        },
        {
          "name": "16 - Check Account Balance After Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Balance is 1000 + 3000 - 35 = 3965', () => pm.expect(res.currentBalance).to.eql(3965));"
                ]
              }
            }
          ]
        },
