              "raw": "{\n  \"description\": \"Erro de tipo\",\n  \"amount\": 10,\n  \"date\": \"2026-05-05T12:00:00Z\",\n  \"type\": 2,\n  \"accountId\": \"{{accountId}}\",\n  \"categoryId\": \"{{incomeCategoryId}}\",\n  \"notes\": \"Income category em expense\"\n}"
