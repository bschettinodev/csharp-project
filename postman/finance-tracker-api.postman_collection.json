          ]
        },
        {
          "name": "20 - Get All Transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has 2 transactions', () => pm.expect(res.length).to.eql(2));",
                  "pm.test('Ordered by date desc', () => {",
                  "  pm.expect(new Date(res[0].date)).to.be.above(new Date(res[1].date));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "21 - Get Transaction By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has all fields', () => {",
                  "  pm.expect(res.accountName).to.be.a('string');",
                  "  pm.expect(res.categoryName).to.be.a('string');",
                  "  pm.expect(res.categoryColor).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "22 - Update Transaction",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Almoço atualizado\",\n  \"amount\": 50,\n  \"date\": \"2026-05-05T12:00:00Z\",\n  \"type\": 2,\n  \"accountId\": \"{{accountId}}\",\n  \"categoryId\": \"{{expenseCategoryId}}\",\n  \"notes\": \"Valor corrigido\"\n}"
            }
          },
          "event": [
