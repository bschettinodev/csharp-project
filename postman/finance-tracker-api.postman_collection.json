        {
          "name": "23 - Check Balance After Update",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Balance is 1000 + 3000 - 50 = 3950', () => pm.expect(res.currentBalance).to.eql(3950));"
                ]
              }
            }
          ]
        },
        {
          "name": "24 - Delete Transaction",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/transactions/{{transactionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "25 - Check Balance After Delete",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Balance is 1000 + 3000 = 4000', () => pm.expect(res.currentBalance).to.eql(4000));"
                ]
              }
            }
          ]
        }
      ]
    },
